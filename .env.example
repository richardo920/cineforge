# Optional local credential fallback for cloud commands without --api-key-file.
# The package does not load .env; export this variable in your shell if needed.
# Never commit a populated .env file. No environment settings are needed for mock runs.
RUNPOD_API_KEY=

# Worker guard: RUNPOD_API_KEY and RUNPOD_POD_ID are injected on the worker
# (or read from PID 1), never configured here; do not forward the local API key.
# PYTORCH_JIT and TORCH_COMPILE_DISABLE are fixed worker-launcher controls.
